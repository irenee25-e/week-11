    // Render Kategori Pilihan
    function renderCategories() {
      const catMap = new Map();
      billiardCues.forEach(cue => {
        if (!catMap.has(cue.category)) {
          catMap.set(cue.category, { name: cue.category, count: 0, image: cue.image });
        }
        catMap.get(cue.category).count += 1;
      });

      const select = document.getElementById("category-filter");
      const currentCat = select.value;
      const cardsContainer = document.getElementById("category-cards-container");

      cardsContainer.innerHTML = Array.from(catMap.values()).map(cat => `
        <div class="cat-card ${currentCat === cat.name ? "active" : ""}" onclick="selectCategory('${cat.name}')">
          <div class="cat-thumb">
            <img src="${imageFolder}/${cat.image}" alt="${cat.name}" onerror="handleImgError(this, '${cat.image}')">
          </div>
          <div class="cat-info">
            <h3>${cat.name}</h3>
            <span>${cat.count} Produk</span>
          </div>
        </div>
      `).join("");
    }

    function selectCategory(catName) {
      const select = document.getElementById("category-filter");
      select.value = (select.value === catName) ? "all" : catName;
      onlyFavorites = false;
      document.getElementById("fav-filter-btn").classList.remove("active");
      renderCategories();
      renderCatalog();
      scrollToSection("katalog");
    }

    // Render Katalog
    function renderCatalog() {
      const container = document.getElementById("catalog-container");
      const countLabel = document.getElementById("product-count");
      const keyword = document.getElementById("search-input").value.toLowerCase().trim();
      const selectedCat = document.getElementById("category-filter").value;
      const sortMode = document.getElementById("sort-filter").value;

      let filtered = billiardCues
        .map((cue, idx) => ({ ...cue, idx }))
        .filter(cue => {
          const matchCat = selectedCat === "all" || cue.category === selectedCat;
          const matchFav = !onlyFavorites || favorites.includes(cue.idx);
          const matchText =
            cue.name.toLowerCase().includes(keyword) ||
            cue.specs.toLowerCase().includes(keyword) ||
            cue.category.toLowerCase().includes(keyword);
          return matchCat && matchFav && matchText;
        });

      if (sortMode === "price-asc") filtered.sort((a, b) => a.price - b.price);
      if (sortMode === "price-desc") filtered.sort((a, b) => b.price - a.price);
      if (sortMode === "rating-desc") filtered.sort((a, b) => b.rating - a.rating);

      countLabel.textContent = onlyFavorites
        ? `Menampilkan ${filtered.length} produk favorit`
        : `Menampilkan ${filtered.length} produk`;

      if (filtered.length === 0) {
        container.innerHTML = `<p style="color:#9ba8a2; grid-column:1/-1;">Produk tidak ditemukan. Coba ubah kata kunci atau filter kategori.</p>`;
        return;
      }

      container.innerHTML = filtered.map(cue => createProductCardHTML(cue)).join("");
    }

    function createProductCardHTML(cue) {
      const badgeClass = cue.limited ? "stock-badge-float limited" : "stock-badge-float";
      const isFav = favorites.includes(cue.idx);
      const imagePath = `${imageFolder}/${cue.image}`;

      return `
        <article class="product-card">
          <div class="product-image" onclick="openProductDetail(${cue.idx})">
            <img src="${imagePath}" alt="${cue.name}" loading="lazy" onerror="handleImgError(this, '${cue.image}')">
            <button class="fav-float-btn ${isFav ? "active" : ""}" type="button" title="Favorit" onclick="event.stopPropagation(); toggleFavorite(${cue.idx})">&#9829;</button>
            <span class="${badgeClass}">${cue.status}</span>
          </div>
          <div class="product-info">
            <div class="card-meta-row">
              <div class="product-category">${cue.category}</div>
              <div class="product-rating">&#9733; ${cue.rating.toFixed(1)}</div>
            </div>
            <h3 class="product-name" onclick="openProductDetail(${cue.idx})">${cue.name}</h3>
            <p class="product-specs">${cue.specs}</p>
            <div class="product-footer">
              <div class="product-price">
                ${formatRupiah(cue.price)}
                ${cue.oldPrice ? `<span class="product-old-price">${formatRupiah(cue.oldPrice)}</span>` : ""}
              </div>
              <button class="add-cart-btn" type="button" onclick="addToCart(${cue.idx}, 1, 'Standard (12.5mm / 19oz)', 0)">+ Beli</button>
            </div>
          </div>
        </article>
      `;
    }

    function toggleFavorite(idx) {
      if (favorites.includes(idx)) {
        favorites = favorites.filter(i => i !== idx);
        showToast("Dihapus dari daftar favorit");
      } else {
        favorites.push(idx);
        showToast("Ditambahkan ke daftar favorit!");
      }
      saveState();
      updateFavUI();
      renderCatalog();
    }

    function updateFavUI() {
      document.getElementById("fav-count").textContent = favorites.length;
    }

    // Halaman Detail Produk (Simulasi Webstore)
    function openProductDetail(idx) {
      activeDetailIdx = idx;
      detailQty = 1;
      selectedTip = "12.5 mm";
      selectedWeight = "19.0 oz";
      selectedPackageExtra = 0;
      selectedPackageName = "Standard Softcase";

      const cue = billiardCues[idx];
      const parts = cue.specs.split("|").map(s => s.trim());

      document.getElementById("home-view").style.display = "none";
      document.getElementById("detail-view").classList.add("active");

      document.getElementById("detail-breadcrumb").innerHTML = `
        <a onclick="navigateHome()">Beranda</a> <span>/</span>
        <a onclick="selectCategory('${cue.category}')">${cue.category}</a> <span>/</span>
        <strong style="color:#ffffff;">${cue.name}</strong>
      `;

      const imgEl = document.getElementById("detail-img");
      imgEl.dataset.fallbackStep = "0";
      imgEl.onerror = function () { handleImgError(this, cue.image); };
      imgEl.src = `${imageFolder}/${cue.image}`;
      imgEl.alt = cue.name;

      document.getElementById("detail-spec-boxes").innerHTML = `
        <div class="spec-mini-box"><span>Diameter Tip</span><strong>${parts[0]?.replace("Tip:", "").trim() || "12.5mm"}</strong></div>
        <div class="spec-mini-box"><span>Berat Standar</span><strong>${parts[1]?.replace("Berat:", "").trim() || "19 oz"}</strong></div>
        <div class="spec-mini-box"><span>Tipe Joint</span><strong>${parts[2]?.replace("Joint:", "").trim() || "Radial"}</strong></div>
      `;

      document.getElementById("detail-category").textContent = cue.category;
      document.getElementById("detail-name").textContent = cue.name;
      document.getElementById("detail-rating").textContent = `★ ${cue.rating.toFixed(1)} (Ulasan Terverifikasi)`;
      document.getElementById("detail-status").textContent = `• ${cue.status}`;
      document.getElementById("detail-desc").textContent =
        `${cue.name} adalah tongkat billiard kategori ${cue.category} dengan spesifikasi ${cue.specs}. Dirancang untuk memberikan akurasi pukulan tinggi, minim defleksi, dan feel solid di setiap break maupun play shot.`;

      document.getElementById("detail-qty").textContent = detailQty;
      updateDetailPrice();
      renderDetailChips();

      // Isi Tab
      document.getElementById("tab-desc-text").textContent =
        `${cue.name} dibuat menggunakan material pilihan yang telah dikeringkan secara alami untuk menjaga stabilitas kayu dan mencegah perubahan bentuk.`;
      document.getElementById("tab-specs-list").innerHTML = parts.map(p => `<li>${p}</li>`).join("") +
        `<li>Panjang Standar: 58 Inch (147 cm) 2-Piece</li>`;

      // Produk Terkait
      const related = billiardCues
        .map((c, i) => ({ ...c, idx: i }))
        .filter(c => c.idx !== idx)
        .sort((a, b) => (a.category === cue.category ? -1 : 1))
        .slice(0, 4);
      document.getElementById("related-container").innerHTML = related.map(c => createProductCardHTML(c)).join("");

      window.scrollTo({ top: 0, behavior: "smooth" });
    }

    function renderDetailChips() {
      const tips = ["12.25 mm", "12.5 mm", "12.75 mm"];
      const weights = ["18.5 oz", "19.0 oz", "19.5 oz"];
      const packages = [
        { label: "Standard Softcase (+Rp 0)", name: "Standard Softcase", extra: 0 },
        { label: "+ Hardcase & Chalk (+Rp 250.000)", name: "Hardcase & Chalk", extra: 250000 }
      ];

      document.getElementById("tip-chips").innerHTML = tips.map(t => `
        <button type="button" class="chip ${selectedTip === t ? "active" : ""}" onclick="pickTip('${t}')">${t}</button>
      `).join("");

      document.getElementById("weight-chips").innerHTML = weights.map(w => `
        <button type="button" class="chip ${selectedWeight === w ? "active" : ""}" onclick="pickWeight('${w}')">${w}</button>
      `).join("");

      document.getElementById("package-chips").innerHTML = packages.map(p => `
        <button type="button" class="chip ${selectedPackageName === p.name ? "active" : ""}" onclick="pickPackage('${p.name}', ${p.extra})">${p.label}</button>
      `).join("");
    }

    function pickTip(t) { selectedTip = t; renderDetailChips(); }
    function pickWeight(w) { selectedWeight = w; renderDetailChips(); }
    function pickPackage(name, extra) {
      selectedPackageName = name;
      selectedPackageExtra = extra;
      renderDetailChips();
      updateDetailPrice();
    }

    function updateDetailPrice() {
      const cue = billiardCues[activeDetailIdx];
      document.getElementById("detail-price").textContent = formatRupiah(cue.price + selectedPackageExtra);
      const oldEl = document.getElementById("detail-old-price");
      if (cue.oldPrice) {
        oldEl.textContent = formatRupiah(cue.oldPrice + selectedPackageExtra);
        oldEl.style.display = "inline";
      } else {
        oldEl.style.display = "none";
      }
    }

    function changeDetailQty(delta) {
      detailQty = Math.max(1, detailQty + delta);
      document.getElementById("detail-qty").textContent = detailQty;
    }

    function switchDetailTab(tabId, btnEl) {
      document.querySelectorAll(".tab-btn").forEach(b => b.classList.remove("active"));
      document.querySelectorAll(".tab-panel").forEach(p => p.classList.remove("active"));
      btnEl.classList.add("active");
      document.getElementById(`tab-${tabId}`).classList.add("active");
    }

    // Keranjang Belanja
    function addToCart(idx, qty = 1, variantLabel = "Standard", extraPrice = 0) {
      const existing = cart.find(item => item.idx === idx && item.variant === variantLabel);
      if (existing) {
        existing.qty += qty;
      } else {
        cart.push({ idx, qty, variant: variantLabel, extraPrice });
      }
      saveState();
      updateCartUI();
      showToast(`${billiardCues[idx].name} ditambahkan ke keranjang!`);
    }

    function changeCartQty(cartIndex, delta) {
      if (!cart[cartIndex]) return;
      cart[cartIndex].qty += delta;
      if (cart[cartIndex].qty <= 0) {
        cart.splice(cartIndex, 1);
      }
      saveState();
      updateCartUI();
    }

    function getCartTotals() {
      const subtotal = cart.reduce((sum, item) => {
        const unitPrice = billiardCues[item.idx].price + (item.extraPrice || 0);
        return sum + unitPrice * item.qty;
      }, 0);
      const discount = Math.round(subtotal * promoDiscountRate);
      const shippingEl = document.getElementById("shipping-method");
      const shipping = cart.length > 0 && shippingEl ? parseInt(shippingEl.value, 10) : 0;
      const total = Math.max(0, subtotal - discount + shipping);
      return { subtotal, discount, shipping, total };
    }

    function updateCartUI() {
      const totalQty = cart.reduce((sum, item) => sum + item.qty, 0);
      const { subtotal, discount, shipping, total } = getCartTotals();

      document.getElementById("cart-count").textContent = totalQty;
      document.getElementById("cart-subtotal").textContent = formatRupiah(subtotal);

      const discountRow = document.getElementById("discount-row");
      if (discount > 0) {
        discountRow.style.display = "flex";
        document.getElementById("cart-discount").textContent = "-" + formatRupiah(discount);
      } else {
        discountRow.style.display = "none";
      }

      document.getElementById("cart-shipping").textContent = shipping === 0 ? "Gratis" : formatRupiah(shipping);
      document.getElementById("cart-total").textContent = formatRupiah(total);

      const container = document.getElementById("cart-items-container");
      if (cart.length === 0) {
        container.innerHTML = `<p style="color:#8f9c96; text-align:center; margin-top:2rem;">Keranjang belanja masih kosong.</p>`;
        return;
      }

      container.innerHTML = cart.map((item, i) => {
        const cue = billiardCues[item.idx];
        const unitPrice = cue.price + (item.extraPrice || 0);
        return `
          <div class="cart-item">
            <img src="${imageFolder}/${cue.image}" alt="${cue.name}" onerror="handleImgError(this, '${cue.image}')">
            <div class="cart-item-info">
              <div class="cart-item-title">${cue.name}</div>
              <div class="cart-item-variant">${item.variant}</div>
              <div class="cart-item-price">${formatRupiah(unitPrice)}</div>
              <div class="qty-controls">
                <button class="qty-btn" type="button" onclick="changeCartQty(${i}, -1)">-</button>
                <span>${item.qty}</span>
                <button class="qty-btn" type="button" onclick="changeCartQty(${i}, 1)">+</button>
                <button class="remove-btn" type="button" onclick="changeCartQty(${i}, -${item.qty})">Hapus</button>
              </div>
            </div>
          </div>
        `;
      }).join("");
    }

    function finishSimulatedOrder() {
      cart = [];
      promoDiscountRate = 0;
      document.getElementById("promo-input").value = "";
      saveState();
      updateCartUI();
      document.getElementById("invoice-modal").classList.remove("active");
      showToast("Pesanan berhasil disimulasikan! Keranjang telah direset.");
    }

    document.addEventListener("DOMContentLoaded", function () {
      const catSelect = document.getElementById("category-filter");
      const categories = [...new Set(billiardCues.map(c => c.category))];
      categories.forEach(cat => {
        const opt = document.createElement("option");
        opt.value = cat;
        opt.textContent = cat;
        catSelect.appendChild(opt);
      });

      document.getElementById("search-input").addEventListener("input", renderCatalog);
      catSelect.addEventListener("change", () => {
        renderCategories();
        renderCatalog();
      });
      document.getElementById("sort-filter").addEventListener("change", renderCatalog);

      document.getElementById("fav-filter-btn").addEventListener("click", function () {
        onlyFavorites = !onlyFavorites;
        this.classList.toggle("active", onlyFavorites);
        scrollToSection("katalog");
        renderCatalog();
      });

      // Detail Buy Buttons
      document.getElementById("detail-add-cart-btn").addEventListener("click", () => {
        const variant = `${selectedTip} / ${selectedWeight} / ${selectedPackageName}`;
        addToCart(activeDetailIdx, detailQty, variant, selectedPackageExtra);
      });

      document.getElementById("detail-buy-now-btn").addEventListener("click", () => {
        const variant = `${selectedTip} / ${selectedWeight} / ${selectedPackageName}`;
        addToCart(activeDetailIdx, detailQty, variant, selectedPackageExtra);
        document.getElementById("cart-drawer-overlay").classList.add("active");
      });

      // Cart Drawer Events
      document.getElementById("open-cart-btn").addEventListener("click", () => {
        document.getElementById("cart-drawer-overlay").classList.add("active");
      });
      document.getElementById("close-cart-btn").addEventListener("click", () => {
        document.getElementById("cart-drawer-overlay").classList.remove("active");
      });
      document.getElementById("cart-drawer-overlay").addEventListener("click", (e) => {
        if (e.target.id === "cart-drawer-overlay") e.target.classList.remove("active");
      });
      document.getElementById("shipping-method").addEventListener("change", updateCartUI);

      // Kode Promo
      document.getElementById("apply-promo-btn").addEventListener("click", () => {
        const code = document.getElementById("promo-input").value.trim().toUpperCase();
        if (code === "PROSTROKE10") {
          promoDiscountRate = 0.1;
          showToast("Kode promo PROSTROKE10 berhasil! Diskon 10%.");
        } else {
          promoDiscountRate = 0;
          showToast("Kode promo tidak valid (coba: PROSTROKE10).");
        }
        updateCartUI();
      });

      // Simulasi Checkout (Invoice Modal)
      document.getElementById("sim-checkout-btn").addEventListener("click", () => {
        if (cart.length === 0) {
          showToast("Keranjang masih kosong!");
          return;
        }
        const name = document.getElementById("buyer-name").value.trim() || "Pelanggan ProStroke";
        const address = document.getElementById("buyer-address").value.trim() || "Jakarta Pusat";
        const shippingSelect = document.getElementById("shipping-method");
        const shippingLabel = shippingSelect.options[shippingSelect.selectedIndex].text;
        const { total } = getCartTotals();

        document.getElementById("inv-buyer-name").textContent = name;
        document.getElementById("inv-number").textContent = "PS-" + Math.floor(100000 + Math.random() * 900000);
        document.getElementById("inv-address").textContent = address;
        document.getElementById("inv-shipping").textContent = shippingLabel;
        document.getElementById("inv-total").textContent = formatRupiah(total);

        document.getElementById("inv-items").innerHTML = cart.map(item => {
          const cue = billiardCues[item.idx];
          const lineTotal = (cue.price + (item.extraPrice || 0)) * item.qty;
          return `
            <div class="invoice-row">
              <span>${cue.name} (${item.qty}x) <br><small style="color:#8f9c96;">${item.variant}</small></span>
              <strong style="color:#ffffff;">${formatRupiah(lineTotal)}</strong>
            </div>
          `;
        }).join("");

        document.getElementById("cart-drawer-overlay").classList.remove("active");
        document.getElementById("invoice-modal").classList.add("active");
      });

      document.getElementById("close-invoice-btn").addEventListener("click", () => {
        document.getElementById("invoice-modal").classList.remove("active");
      });

      // Checkout WhatsApp
      document.getElementById("wa-checkout-btn").addEventListener("click", () => {
        if (cart.length === 0) {
          showToast("Keranjang masih kosong!");
          return;
        }
        const name = document.getElementById("buyer-name").value.trim() || "Pelanggan";
        const address = document.getElementById("buyer-address").value.trim() || "-";
        const { discount, shipping, total } = getCartTotals();
        let text = `Halo ProStroke Billiard, saya ingin memesan:\n\n`;
        cart.forEach(item => {
          const cue = billiardCues[item.idx];
          const subtotal = (cue.price + (item.extraPrice || 0)) * item.qty;
          text += `- ${cue.name} [${item.variant}] (${item.qty}x) = ${formatRupiah(subtotal)}\n`;
        });
        if (discount > 0) text += `\nDiskon Promo: -${formatRupiah(discount)}`;
        text += `\nOngkos Kirim: ${shipping === 0 ? "Gratis" : formatRupiah(shipping)}`;
        text += `\n*Total: ${formatRupiah(total)}*\n`;
        text += `Nama: ${name}\nAlamat: ${address}`;
        window.open(`https://wa.me/${storeWhatsApp}?text=${encodeURIComponent(text)}`, "_blank");
      });

      renderSpotlight();
      renderCategories();
      renderCatalog();
      updateFavUI();
      updateCartUI();
    });
  </script>
</body>
</html>
