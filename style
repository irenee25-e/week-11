<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ProStroke Billiard — Toko &amp; Katalog Tongkat Billiard</title>
  <style>
    /* Reset & Dasar */
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background-color: #111413;
      color: #f0f2f1;
      line-height: 1.6;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 2rem;
    }

    /* 1. Top Announcement Bar */
    .top-bar {
      background-color: #071b14;
      color: #cbd5d0;
      font-size: 0.78rem;
      padding: 0.45rem 0;
      border-bottom: 1px solid #16382b;
    }

    .top-bar-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .top-highlight {
      color: #c9a24d;
      font-weight: 700;
    }

    .top-bar-right {
      display: flex;
      gap: 0.4rem;
    }

    .social-dot {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 22px;
      height: 22px;
      border-radius: 50%;
      background-color: #13382a;
      color: #c9a24d;
      font-size: 0.62rem;
      font-weight: 700;
    }

    /* 2. Header */
    header {
      background-color: #0b291e;
      border-bottom: 2px solid #c9a24d;
      padding: 0.9rem 0;
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .header-container {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      text-decoration: none;
      cursor: pointer;
    }

    .brand-title {
      font-size: 1.35rem;
      font-weight: 700;
      letter-spacing: 1px;
      color: #ffffff;
    }

    .brand-title span {
      color: #c9a24d;
    }

    .nav-right {
      display: flex;
      align-items: center;
      gap: 1.25rem;
      flex-wrap: wrap;
    }

    .nav-list {
      list-style: none;
      display: flex;
      gap: 1.25rem;
      font-size: 0.92rem;
    }

    .nav-list a {
      color: #cbd5d0;
      text-decoration: none;
      transition: color 0.2s;
      cursor: pointer;
    }

    .nav-list a:hover,
    .nav-list a.active {
      color: #c9a24d;
      font-weight: 600;
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }

    .icon-action-btn {
      background-color: #123b2c;
      color: #f0f2f1;
      border: 1px solid #1f5c45;
      padding: 0.5rem 0.75rem;
      border-radius: 6px;
      font-size: 0.85rem;
      font-weight: 600;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      transition: all 0.2s;
    }

    .icon-action-btn:hover,
    .icon-action-btn.active {
      border-color: #c9a24d;
      color: #c9a24d;
    }

    .cart-btn {
      background-color: #c9a24d;
      color: #111413;
      border: none;
      padding: 0.55rem 1rem;
      border-radius: 6px;
      font-weight: 700;
      font-size: 0.9rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      transition: background-color 0.2s;
    }

    .cart-btn:hover {
      background-color: #dbb562;
    }

    .cart-count {
      background-color: #0b291e;
      color: #ffffff;
      font-size: 0.75rem;
      padding: 0.1rem 0.45rem;
      border-radius: 999px;
    }

    /* 3. Ticker / Marquee Strip */
    .ticker-strip {
      background-color: #c9a24d;
      color: #111413;
      overflow: hidden;
      padding: 0.45rem 0;
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.8px;
    }

    .ticker-track {
      display: flex;
      width: max-content;
      white-space: nowrap;
      animation: ticker-scroll 32s linear infinite;
    }

    .ticker-track:hover {
      animation-play-state: paused;
    }

    .ticker-item {
      padding: 0 1.5rem;
      text-transform: uppercase;
    }

    @keyframes ticker-scroll {
      from { transform: translateX(0); }
      to { transform: translateX(-50%); }
    }

    /* 4. Hero Section (2 Kolom + Spotlight) */
    .hero {
      background: linear-gradient(135deg, #0f3829 0%, #111413 100%);
      padding: 3.5rem 0;
      border-bottom: 1px solid #222926;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1.25fr 0.9fr;
      gap: 2.5rem;
      align-items: center;
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.78rem;
      font-weight: 600;
      color: #6ee7b7;
      background-color: rgba(11, 41, 30, 0.85);
      border: 1px solid #1f6e51;
      padding: 0.3rem 0.85rem;
      border-radius: 999px;
      margin-bottom: 1rem;
    }

    .hero-badge-dot {
      width: 8px;
      height: 8px;
      background-color: #6ee7b7;
      border-radius: 50%;
    }

    .hero h1 {
      font-size: 2.35rem;
      line-height: 1.2;
      margin-bottom: 0.85rem;
      color: #ffffff;
    }

    .hero h1 span {
      color: #c9a24d;
    }

    .hero p {
      color: #b0bdb7;
      font-size: 1.02rem;
      margin-bottom: 1.5rem;
      max-width: 560px;
    }

    .hero-actions {
      display: flex;
      align-items: center;
      gap: 1rem;
      flex-wrap: wrap;
      margin-bottom: 2rem;
    }

    .hero-cta {
      display: inline-block;
      background-color: #c9a24d;
      color: #111413;
      text-decoration: none;
      font-weight: 700;
      padding: 0.75rem 1.75rem;
      border-radius: 6px;
      transition: background-color 0.2s;
      border: none;
      cursor: pointer;
    }

    .hero-cta:hover {
      background-color: #dbb562;
    }

    .hero-cta-outline {
      display: inline-block;
      color: #f0f2f1;
      text-decoration: none;
      font-weight: 600;
      padding: 0.75rem 1.25rem;
      border-radius: 6px;
      border: 1px solid #31443c;
      transition: border-color 0.2s, color 0.2s;
    }

    .hero-cta-outline:hover {
      border-color: #c9a24d;
      color: #c9a24d;
    }

    .hero-stats {
      display: flex;
      gap: 2rem;
      flex-wrap: wrap;
      border-top: 1px solid #1e332a;
      padding-top: 1.25rem;
    }

    .stat-item strong {
      display: block;
      font-size: 1.35rem;
      color: #c9a24d;
      line-height: 1.2;
    }

    .stat-item span {
      font-size: 0.78rem;
      color: #9ba8a2;
    }

    /* Spotlight Card */
    .hero-spotlight {
      background-color: #191e1c;
      border: 1px solid #c9a24d;
      border-radius: 12px;
      padding: 1.25rem;
      cursor: pointer;
      transition: transform 0.2s, box-shadow 0.2s;
    }

    .hero-spotlight:hover {
      transform: translateY(-4px);
      box-shadow: 0 10px 28px rgba(0, 0, 0, 0.45);
    }

    .spotlight-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.75rem;
    }

    .spotlight-label {
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      background-color: #0f3829;
      color: #c9a24d;
      padding: 0.25rem 0.65rem;
      border-radius: 999px;
      border: 1px solid #1f6e51;
    }

    .spotlight-img-box {
      height: 200px;
      border-radius: 8px;
      overflow: hidden;
      background-color: #121614;
      margin-bottom: 0.9rem;
    }

    .spotlight-img-box img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .spotlight-name {
      font-size: 1.15rem;
      font-weight: 700;
      color: #ffffff;
    }

    .spotlight-meta {
      font-size: 0.82rem;
      color: #9ba8a2;
      margin: 0.25rem 0 0.75rem;
    }

    .spotlight-bottom {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-top: 0.75rem;
      border-top: 1px solid #28302d;
    }

    /* 5. Category Showcase Section */
    .category-section {
      padding: 2.5rem 0 0.5rem;
    }

    .category-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
      gap: 1rem;
    }

    .cat-card {
      background-color: #191e1c;
      border: 1px solid #28302d;
      border-radius: 10px;
      padding: 0.85rem;
      display: flex;
      align-items: center;
      gap: 0.85rem;
      cursor: pointer;
      transition: border-color 0.2s, transform 0.2s, background-color 0.2s;
    }

    .cat-card:hover,
    .cat-card.active {
      border-color: #c9a24d;
      background-color: #1e2723;
      transform: translateY(-2px);
    }

    .cat-thumb {
      width: 52px;
      height: 52px;
      border-radius: 8px;
      overflow: hidden;
      flex-shrink: 0;
      border: 1px solid #2e3834;
    }

    .cat-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .cat-info h3 {
      font-size: 0.88rem;
      color: #ffffff;
      line-height: 1.25;
      margin-bottom: 0.15rem;
    }

    .cat-info span {
      font-size: 0.75rem;
      color: #c9a24d;
    }

    /* 6. Filter & Katalog */
    main {
      padding: 2rem 0 3rem;
    }

    .controls-bar {
      display: flex;
      flex-wrap: wrap;
      gap: 0.85rem;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.75rem;
      background-color: #191e1c;
      padding: 1rem 1.25rem;
      border-radius: 10px;
      border: 1px solid #28302d;
    }

    .search-input {
      flex: 1;
      min-width: 220px;
      padding: 0.65rem 1rem;
      border-radius: 6px;
      border: 1px solid #2e3834;
      background-color: #111413;
      color: #ffffff;
      font-size: 0.95rem;
    }

    .search-input:focus {
      outline: none;
      border-color: #c9a24d;
    }

    .filter-select {
      padding: 0.65rem 1rem;
      border-radius: 6px;
      border: 1px solid #2e3834;
      background-color: #111413;
      color: #ffffff;
      font-size: 0.92rem;
      cursor: pointer;
    }

    .section-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 1.5rem;
      border-bottom: 1px solid #262e2b;
      padding-bottom: 0.75rem;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .section-header h2 {
      font-size: 1.45rem;
      color: #c9a24d;
    }

    .section-header span {
      font-size: 0.9rem;
      color: #8f9c96;
    }

    /* Grid Produk */
    .catalog-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
      gap: 1.5rem;
    }

    .product-card {
      background-color: #191e1c;
      border: 1px solid #28302d;
      border-radius: 10px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      transition: transform 0.2s, border-color 0.2s;
    }

    .product-card:hover {
      transform: translateY(-4px);
      border-color: #c9a24d;
    }

    .product-image {
      background-color: #121614;
      border-bottom: 1px solid #28302d;
      height: 220px;
      overflow: hidden;
      cursor: pointer;
      position: relative;
    }

    .product-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.3s;
    }

    .product-card:hover .product-image img {
      transform: scale(1.04);
    }

    .stock-badge-float {
      position: absolute;
      top: 10px;
      right: 10px;
      font-size: 0.72rem;
      padding: 0.22rem 0.55rem;
      border-radius: 4px;
      background-color: rgba(15, 56, 41, 0.92);
      color: #6ee7b7;
      border: 1px solid #1b5e45;
      font-weight: 600;
    }

    .stock-badge-float.limited {
      background-color: rgba(56, 42, 15, 0.92);
      color: #fcd34d;
      border-color: #664d1b;
    }

    .fav-float-btn {
      position: absolute;
      top: 10px;
      left: 10px;
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background-color: rgba(17, 20, 19, 0.82);
      border: 1px solid #2e3834;
      color: #cbd5d0;
      font-size: 1rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s;
    }

    .fav-float-btn:hover,
    .fav-float-btn.active {
      color: #f87171;
      border-color: #f87171;
      background-color: rgba(35, 18, 18, 0.92);
    }

    .product-info {
      padding: 1.15rem;
      display: flex;
      flex-direction: column;
      flex-grow: 1;
    }

    .card-meta-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.35rem;
    }

    .product-category {
      font-size: 0.74rem;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      color: #c9a24d;
      font-weight: 600;
    }

    .product-rating {
      font-size: 0.78rem;
      color: #fcd34d;
      font-weight: 700;
    }

    .product-name {
      font-size: 1.12rem;
      font-weight: 700;
      color: #ffffff;
      margin-bottom: 0.45rem;
      cursor: pointer;
    }

    .product-name:hover {
      color: #c9a24d;
    }

    .product-specs {
      font-size: 0.83rem;
      color: #9ba8a2;
      margin-bottom: 1.1rem;
      flex-grow: 1;
    }

    .product-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 0.75rem;
      padding-top: 0.9rem;
      border-top: 1px solid #262e2b;
    }

    .product-price {
      font-size: 1.05rem;
      font-weight: 700;
      color: #ffffff;
    }

    .product-old-price {
      display: block;
      font-size: 0.75rem;
      color: #7d8a84;
      text-decoration: line-through;
      font-weight: 400;
    }

    .add-cart-btn {
      background-color: #0f3829;
      color: #ffffff;
      border: 1px solid #1f6e51;
      padding: 0.48rem 0.9rem;
      border-radius: 6px;
      font-size: 0.85rem;
      font-weight: 600;
      cursor: pointer;
      transition: background-color 0.2s, border-color 0.2s, color 0.2s;
    }

    .add-cart-btn:hover {
      background-color: #c9a24d;
      color: #111413;
      border-color: #c9a24d;
    }

    /* 7. Halaman Detail Produk (Full Webstore Simulation View) */
    .detail-view {
      display: none;
      padding: 2rem 0 3rem;
    }

    .detail-view.active {
      display: block;
    }

    .breadcrumb-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
      margin-bottom: 1.75rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid #262e2b;
    }

    .breadcrumb {
      font-size: 0.85rem;
      color: #8f9c96;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      flex-wrap: wrap;
    }

    .breadcrumb a {
      color: #c9a24d;
      text-decoration: none;
      cursor: pointer;
    }

    .back-btn {
      background-color: #191e1c;
      color: #f0f2f1;
      border: 1px solid #313d38;
      padding: 0.45rem 0.95rem;
      border-radius: 6px;
      font-size: 0.85rem;
      font-weight: 600;
      cursor: pointer;
    }

    .back-btn:hover {
      border-color: #c9a24d;
      color: #c9a24d;
    }

    .detail-grid {
      display: grid;
      grid-template-columns: 1fr 1.1fr;
      gap: 2.5rem;
      align-items: start;
      margin-bottom: 3rem;
    }

    .detail-gallery-box {
      background-color: #121614;
      border: 1px solid #28302d;
      border-radius: 12px;
      overflow: hidden;
      height: 410px;
      margin-bottom: 0.9rem;
    }

    .detail-gallery-box img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .detail-spec-boxes {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.75rem;
    }

    .spec-mini-box {
      background-color: #191e1c;
      border: 1px solid #28302d;
      border-radius: 8px;
      padding: 0.75rem;
      text-align: center;
    }

    .spec-mini-box span {
      display: block;
      font-size: 0.7rem;
      text-transform: uppercase;
      color: #8f9c96;
      margin-bottom: 0.2rem;
    }

    .spec-mini-box strong {
      font-size: 0.85rem;
      color: #ffffff;
    }

    .detail-cat-pill {
      display: inline-block;
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      color: #c9a24d;
      background-color: #0b291e;
      border: 1px solid #1f6e51;
      padding: 0.25rem 0.75rem;
      border-radius: 999px;
      font-weight: 700;
      margin-bottom: 0.75rem;
    }

    .detail-title {
      font-size: 1.9rem;
      color: #ffffff;
      margin-bottom: 0.5rem;
    }

    .detail-rating-row {
      display: flex;
      align-items: center;
      gap: 1rem;
      font-size: 0.85rem;
      color: #9ba8a2;
      margin-bottom: 1.15rem;
    }

    .detail-price-box {
      padding: 1rem 0;
      border-top: 1px solid #262e2b;
      border-bottom: 1px solid #262e2b;
      margin-bottom: 1.25rem;
      display: flex;
      align-items: baseline;
      gap: 0.85rem;
    }

    .detail-price {
      font-size: 1.75rem;
      font-weight: 800;
      color: #c9a24d;
    }

    .detail-old-price {
      font-size: 1.05rem;
      color: #7d8a84;
      text-decoration: line-through;
    }

    .variant-group {
      margin-bottom: 1.15rem;
    }

    .variant-label {
      display: block;
      font-size: 0.8rem;
      font-weight: 700;
      color: #cbd5d0;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      margin-bottom: 0.5rem;
    }

    .chip-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .chip {
      background-color: #191e1c;
      color: #cbd5d0;
      border: 1px solid #2e3834;
      padding: 0.45rem 0.9rem;
      border-radius: 999px;
      font-size: 0.82rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
    }

    .chip:hover {
      border-color: #c9a24d;
    }

    .chip.active {
      background-color: #c9a24d;
      color: #111413;
      border-color: #c9a24d;
    }

    .detail-buy-row {
      display: flex;
      gap: 0.85rem;
      flex-wrap: wrap;
      margin-top: 1.5rem;
      align-items: center;
    }

    .detail-qty-box {
      display: flex;
      align-items: center;
      background-color: #191e1c;
      border: 1px solid #2e3834;
      border-radius: 6px;
      overflow: hidden;
    }

    .detail-qty-box button {
      background: none;
      border: none;
      color: #ffffff;
      width: 36px;
      height: 42px;
      font-size: 1.1rem;
      cursor: pointer;
    }

    .detail-qty-box span {
      width: 36px;
      text-align: center;
      font-weight: 700;
    }

    .btn-gold-lg {
      flex: 1;
      min-width: 170px;
      background-color: #c9a24d;
      color: #111413;
      border: none;
      padding: 0.78rem 1.25rem;
      border-radius: 6px;
      font-weight: 700;
      font-size: 0.95rem;
      cursor: pointer;
    }

    .btn-gold-lg:hover {
      background-color: #dbb562;
    }

    .btn-green-lg {
      flex: 1;
      min-width: 160px;
      background-color: #0f3829;
      color: #ffffff;
      border: 1px solid #1f6e51;
      padding: 0.78rem 1.25rem;
      border-radius: 6px;
      font-weight: 700;
      font-size: 0.95rem;
      cursor: pointer;
    }

    .btn-green-lg:hover {
      border-color: #c9a24d;
      color: #c9a24d;
    }

    .detail-notice {
      margin-top: 1.25rem;
      background-color: rgba(15, 56, 41, 0.45);
      border-left: 3px solid #c9a24d;
      padding: 0.85rem 1rem;
      border-radius: 6px;
      font-size: 0.84rem;
      color: #cbd5d0;
    }

    /* Tabs Detail Produk */
    .tabs-wrapper {
      background-color: #191e1c;
      border: 1px solid #28302d;
      border-radius: 12px;
      padding: 1.5rem;
      margin-bottom: 3rem;
    }

