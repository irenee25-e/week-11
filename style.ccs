/* ============================================================
   ProStroke Billiard — Dark Emerald & Gold Webstore Stylesheet
   ============================================================ */

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

:root {
  --bg-main: #111413;
  --bg-card: #191e1c;
  --bg-dark: #0c0f0e;
  --bg-input: #121614;
  --felt-dark: #071b14;
  --felt-primary: #0b291e;
  --felt-mid: #0f3829;
  --felt-border: #1f6e51;
  --gold: #c9a24d;
  --gold-hover: #dbb562;
  --text-light: #f0f2f1;
  --text-muted: #9ba8a2;
  --border-dark: #28302d;
  --mint: #6ee7b7;
  --amber: #fcd34d;
  --danger: #f87171;
  --radius: 10px;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  background-color: var(--bg-main);
  color: var(--text-light);
  line-height: 1.6;
}

.container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 1.5rem;
}

/* 1. Top Bar */
.top-bar {
  background-color: var(--felt-dark);
  border-bottom: 1px solid #16382b;
  font-size: 0.78rem;
  color: #cbd5d0;
  padding: 0.45rem 0;
}

.top-bar-inner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.top-highlight {
  color: var(--gold);
  font-weight: 700;
}

.top-bar-right {
  display: flex;
  gap: 0.4rem;
}

.social-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 22px;
  height: 22px;
  border-radius: 50%;
  background-color: #13382a;
  color: var(--gold);
  font-size: 0.62rem;
  font-weight: 700;
}

/* 2. Header */
.site-header {
  background-color: var(--felt-primary);
  border-bottom: 2px solid var(--gold);
  padding: 0.85rem 0;
  position: sticky;
  top: 0;
  z-index: 100;
}

.header-inner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 1rem;
}

.brand {
  display: flex;
  align-items: center;
  gap: 0.7rem;
  text-decoration: none;
}

.brand-title {
  font-size: 1.3rem;
  font-weight: 800;
  letter-spacing: 0.8px;
  color: #ffffff;
}

.brand-title span {
  color: var(--gold);
}

.main-nav {
  display: flex;
  align-items: center;
  gap: 0.35rem;
  flex-wrap: wrap;
  justify-content: center;
}

.nav-link {
  color: #cbd5d0;
  text-decoration: none;
  font-size: 0.88rem;
  font-weight: 500;
  padding: 0.4rem 0.75rem;
  border-radius: 6px;
  transition: background-color 0.2s, color 0.2s;
}

.nav-link:hover,
.nav-link.active {
  background-color: var(--felt-mid);
  color: var(--gold);
  font-weight: 600;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 0.6rem;
}

.action-pill-btn {
  text-decoration: none;
  background-color: #123b2c;
  color: var(--text-light);
  border: 1px solid #1f5c45;
  padding: 0.48rem 0.75rem;
  border-radius: 6px;
  font-size: 0.85rem;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  transition: border-color 0.2s, color 0.2s;
}

.action-pill-btn:hover,
.action-pill-btn.active {
  border-color: var(--gold);
  color: var(--gold);
}

.cart-btn {
  background-color: var(--gold);
  color: var(--bg-main);
  border: none;
  padding: 0.52rem 1rem;
  border-radius: 6px;
  font-weight: 700;
  font-size: 0.88rem;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  transition: background-color 0.2s;
}

.cart-btn:hover {
  background-color: var(--gold-hover);
}

.cart-badge {
  background-color: var(--felt-primary);
  color: #ffffff;
  font-size: 0.74rem;
  padding: 0.08rem 0.45rem;
  border-radius: 999px;
}

/* 3. Ticker Strip */
.ticker-strip {
  background-color: var(--gold);
  color: var(--bg-main);
  overflow: hidden;
  padding: 0.45rem 0;
  font-size: 0.78rem;
  font-weight: 800;
  letter-spacing: 0.7px;
}

.ticker-track {
  display: flex;
  width: max-content;
  white-space: nowrap;
  animation: ticker-run 30s linear infinite;
}

.ticker-track:hover {
  animation-play-state: paused;
}

.ticker-item {
  padding: 0 1.4rem;
  text-transform: uppercase;
}

@keyframes ticker-run {
  from { transform: translateX(0); }
  to { transform: translateX(-50%); }
}

/* 4. Hero Section */
.hero {
  background: linear-gradient(135deg, var(--felt-mid) 0%, var(--bg-main) 100%);
  padding: 3.25rem 0;
  border-bottom: 1px solid #222926;
}

.hero-grid {
  display: grid;
  grid-template-columns: 1.25fr 0.9fr;
  gap: 2.5rem;
  align-items: center;
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.78rem;
  font-weight: 600;
  color: var(--mint);
  background-color: rgba(11, 41, 30, 0.85);
  border: 1px solid var(--felt-border);
  padding: 0.28rem 0.85rem;
  border-radius: 999px;
  margin-bottom: 1rem;
}

.hero-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background-color: var(--mint);
}

.hero h1 {
  font-size: clamp(1.9rem, 3.5vw, 2.45rem);
  line-height: 1.18;
  margin-bottom: 0.85rem;
  color: #ffffff;
}

.hero h1 span {
  color: var(--gold);
}

.hero-desc {
  color: #b0bdb7;
  font-size: 1rem;
  margin-bottom: 1.5rem;
  max-width: 540px;
}

.hero-actions {
  display: flex;
  gap: 0.85rem;
  flex-wrap: wrap;
  margin-bottom: 2rem;
}

.btn-gold {
  display: inline-block;
  background-color: var(--gold);
  color: var(--bg-main);
  text-decoration: none;
  font-weight: 700;
  padding: 0.72rem 1.55rem;
  border-radius: 6px;
  border: none;
  cursor: pointer;
  transition: background-color 0.2s;
}

.btn-gold:hover {
  background-color: var(--gold-hover);
}

.btn-outline {
  display: inline-block;
  color: var(--text-light);
  text-decoration: none;
  font-weight: 600;
  padding: 0.72rem 1.25rem;
  border-radius: 6px;
  border: 1px solid #31443c;
  transition: border-color 0.2s, color 0.2s;
}

.btn-outline:hover {
  border-color: var(--gold);
  color: var(--gold);
}

.hero-stats {
  display: flex;
  gap: 2rem;
  flex-wrap: wrap;
  padding-top: 1.15rem;
  border-top: 1px solid #1e332a;
}

.stat-item strong {
  display: block;
  font-size: 1.3rem;
  color: var(--gold);
}

.stat-item span {
  font-size: 0.78rem;
  color: var(--text-muted);
}

/* Spotlight Card */
.spotlight-card {
  display: block;
  text-decoration: none;
  color: inherit;
  background-color: var(--bg-card);
  border: 1px solid var(--gold);
  border-radius: 12px;
  padding: 1.2rem;
  transition: transform 0.2s, box-shadow 0.2s;
}

.spotlight-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 28px rgba(0, 0, 0, 0.45);
}

.spotlight-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 0.75rem;
}

.spotlight-tag {
  font-size: 0.72rem;
  font-weight: 700;
  text-transform: uppercase;
  color: var(--gold);
  background-color: var(--felt-mid);
  border: 1px solid var(--felt-border);
  padding: 0.2rem 0.65rem;
  border-radius: 999px;
}

.spotlight-img {
  height: 200px;
  border-radius: 8px;
  overflow: hidden;
  background-color: var(--bg-input);
  margin-bottom: 0.85rem;
}

.spotlight-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.spotlight-title {
  font-size: 1.12rem;
  font-weight: 700;
  color: #ffffff;
}

.spotlight-specs {
  font-size: 0.82rem;
  color: var(--text-muted);
  margin: 0.25rem 0 0.8rem;
}

.spotlight-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 0.75rem;
  border-top: 1px solid var(--border-dark);
}

/* 5. Section Shared & Category Grid */
.section-block {
  padding: 2.5rem 0;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin-bottom: 1.5rem;
  padding-bottom: 0.7rem;
  border-bottom: 1px solid #262e2b;
}

.section-header h2 {
  font-size: 1.45rem;
  color: var(--gold);
}

.section-header span {
  font-size: 0.88rem;
  color: var(--text-muted);
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
  gap: 1rem;
}

.cat-card {
  text-decoration: none;
  background-color: var(--bg-card);
  border: 1px solid var(--border-dark);
  border-radius: var(--radius);
  padding: 0.85rem;
  display: flex;
  align-items: center;
  gap: 0.8rem;
  transition: border-color 0.2s, transform 0.2s;
}

.cat-card:hover {
  border-color: var(--gold);
  transform: translateY(-2px);
}

.cat-thumb {
  width: 52px;
  height: 52px;
  border-radius: 8px;
  overflow: hidden;
  flex-shrink: 0;
  border: 1px solid #2e3834;
}

.cat-thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.cat-card h3 {
  font-size: 0.9rem;
  color: #ffffff;
  line-height: 1.25;
}

.cat-card span {
  font-size: 0.76rem;
  color: var(--gold);
}

/* 6. Controls & Product Grid */
.controls-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 0.85rem;
  background-color: var(--bg-card);
  border: 1px solid var(--border-dark);
  border-radius: var(--radius);
  padding: 1rem 1.15rem;
  margin-bottom: 1.5rem;
}

.search-input {
  flex: 1;
  min-width: 220px;
  padding: 0.62rem 0.95rem;
  border-radius: 6px;
  border: 1px solid #2e3834;
  background-color: var(--bg-main);
  color: #ffffff;
  font-size: 0.94rem;
}

.search-input:focus {
  outline: none;
  border-color: var(--gold);
}

.filter-select {
  padding: 0.62rem 0.95rem;
  border-radius: 6px;
  border: 1px solid #2e3834;
  background-color: var(--bg-main);
  color: #ffffff;
  font-size: 0.9rem;
  cursor: pointer;
}

.catalog-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
  gap: 1.5rem;
}

.product-card {
  background-color: var(--bg-card);
  border: 1px solid var(--border-dark);
  border-radius: var(--radius);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: transform 0.2s, border-color 0.2s;
}

.product-card:hover {
  transform: translateY(-4px);
  border-color: var(--gold);
}

.product-media {
  position: relative;
  height: 220px;
  background-color: var(--bg-input);
  border-bottom: 1px solid var(--border-dark);
  overflow: hidden;
  display: block;
}

.product-media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.3s;
}

.product-card:hover .product-media img {
  transform: scale(1.04);
}

.stock-pill {
  position: absolute;
  top: 10px;
  right: 10px;
  font-size: 0.72rem;
  font-weight: 600;
  padding: 0.2rem 0.55rem;
  border-radius: 4px;
  background-color: rgba(15, 56, 41, 0.92);
  color: var(--mint);
  border: 1px solid #1b5e45;
}

.stock-pill.limited {
  background-color: rgba(56, 42, 15, 0.92);
  color: var(--amber);
  border-color: #664d1b;
}

.fav-btn {
  position: absolute;
  top: 10px;
  left: 10px;
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background-color: rgba(17, 20, 19, 0.84);
  border: 1px solid #2e3834;
  color: #cbd5d0;
  font-size: 1rem;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
}

.fav-btn.active,
.fav-btn:hover {
  color: var(--danger);
  border-color: var(--danger);
}

.product-body {
  padding: 1.15rem;
  display: flex;
  flex-direction: column;
  flex: 1;
}

.meta-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 0.35rem;
}

.cat-label {
  font-size: 0.73rem;
  text-transform: uppercase;
  letter-spacing: 0.8px;
  color: var(--gold);
  font-weight: 700;
}

.rating-label {
  font-size: 0.78rem;
  color: var(--amber);
  font-weight: 700;
}

.product-title-link {
  text-decoration: none;
  color: #ffffff;
  font-size: 1.1rem;
  font-weight: 700;
  margin-bottom: 0.4rem;
  display: block;
}

.product-title-link:hover {
  color: var(--gold);
}

.product-specs {
  font-size: 0.83rem;
  color: var(--text-muted);
  margin-bottom: 1.1rem;
  flex: 1;
}

.product-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 0.75rem;
  padding-top: 0.9rem;
  border-top: 1px solid #262e2b;
}

.price-now {
  font-size: 1.05rem;
  font-weight: 700;
  color: #ffffff;
}

.price-old {
  display: block;
  font-size: 0.75rem;
  color: #7d8a84;
  text-decoration: line-through;
  font-weight: 400;
}

.add-btn {
  background-color: var(--felt-mid);
  color: #ffffff;
  border: 1px solid var(--felt-border);
  padding: 0.48rem 0.9rem;
  border-radius: 6px;
  font-size: 0.85rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s;
}

.add-btn:hover {
  background-color: var(--gold);
  color: var(--bg-main);
  border-color: var(--gold);
}

/* 7. Page Banner & Breadcrumb (Halaman Kategori & Detail) */
.page-banner {
  background: linear-gradient(135deg, var(--felt-primary) 0%, var(--bg-main) 100%);
  padding: 2.5rem 0;
  border-bottom: 1px solid #222926;
  text-align: center;
}

.page-banner h1 {
  font-size: 2rem;
  color: #ffffff;
  margin-bottom: 0.5rem;
}

.breadcrumb {
  font-size: 0.86rem;
  color: var(--text-muted);
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 0.5rem;
  flex-wrap: wrap;
}

.breadcrumb a {
  color: var(--gold);
  text-decoration: none;
}

.cat-intro-box {
  background-color: var(--bg-card);
  border: 1px solid var(--border-dark);
  border-left: 4px solid var(--gold);
  border-radius: var(--radius);
  padding: 1.15rem 1.35rem;
  margin-bottom: 1.75rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 1rem;
}

.pill-count {
  font-size: 0.8rem;
  font-weight: 700;
  background-color: var(--felt-mid);
  color: var(--mint);
  border: 1px solid var(--felt-border);
  padding: 0.3rem 0.85rem;
  border-radius: 999px;
}

/* 8. Halaman Detail Produk */
.detail-grid {
  display: grid;
  grid-template-columns: 1fr 1.1fr;
  gap: 2.5rem;
  align-items: start;
  margin-bottom: 2.5rem;
}

.detail-gallery {
  background-color: var(--bg-input);
  border: 1px solid var(--border-dark);
  border-radius: 12px;
  height: 400px;
  overflow: hidden;
  margin-bottom: 0.9rem;
}

.detail-gallery img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.detail-spec-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0.75rem;
}

.spec-mini {
  background-color: var(--bg-card);
  border: 1px solid var(--border-dark);
  border-radius: 8px;
  padding: 0.75rem;
  text-align: center;
}

.spec-mini span {
  display: block;
  font-size: 0.7rem;
  text-transform: uppercase;
  color: var(--text-muted);
}

.spec-mini strong {
  font-size: 0.86rem;
  color: #ffffff;
}

.detail-title {
  font-size: 1.9rem;
  color: #ffffff;
  margin: 0.5rem 0;
}

.detail-price-wrap {
  display: flex;
  align-items: baseline;
  gap: 0.9rem;
  padding: 1rem 0;
  margin: 1rem 0;
  border-top: 1px solid #262e2b;
  border-bottom: 1px solid #262e2b;
}

.detail-price-now {
  font-size: 1.75rem;
  font-weight: 800;
  color: var(--gold);
}

.variant-block {
  margin-bottom: 1.1rem;
}

.variant-label {
  display: block;
  font-size: 0.78rem;
  font-weight: 700;
  text-transform: uppercase;
  color: #cbd5d0;
  margin-bottom: 0.45rem;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.chip {
  background-color: var(--bg-card);
  color: #cbd5d0;
  border: 1px solid #2e3834;
  padding: 0.42rem 0.9rem;
  border-radius: 999px;
  font-size: 0.82rem;
  font-weight: 600;
  cursor: pointer;
}

.chip.active {
  background-color: var(--gold);
  color: var(--bg-main);
  border-color: var(--gold);
}

.detail-actions {
  display: flex;
  gap: 0.8rem;
  flex-wrap: wrap;
  margin-top: 1.4rem;
  align-items: center;
}

.qty-stepper {
  display: flex;
  align-items: center;
  background-color: var(--bg-card);
  border: 1px solid #2e3834;
  border-radius: 6px;
}

.qty-stepper button {
  background: none;
  border: none;
  color: #ffffff;
  width: 36px;
  height: 42px;
  font-size: 1.1rem;
  cursor: pointer;
}

.qty-stepper span {
  width: 34px;
  text-align: center;
  font-weight: 700;
}

.btn-green-lg {
  flex: 1;
  min-width: 150px;
  background-color: var(--felt-mid);
  color: #ffffff;
  border: 1px solid var(--felt-border);
  padding: 0.78rem 1.2rem;
  border-radius: 6px;
  font-weight: 700;
  cursor: pointer;
}

.btn-green-lg:hover {
  border-color: var(--gold);
  color: var(--gold);
}

.detail-notice {
  margin-top: 1.25rem;
  padding: 0.85rem 1rem;
  background-color: rgba(15, 56, 41, 0.45);
  border-left: 3px solid var(--gold);
  border-radius: 6px;
  font-size: 0.85rem;
  color: #cbd5d0;
}

/* Tabs */
.tabs-card {
  background-color: var(--bg-card);
  border: 1px solid var(--border-dark);
  border-radius: 12px;
  padding: 1.5rem;
  margin-bottom: 2.5rem;
}

.tabs-head {
  display: flex;
  gap: 0.5rem;
  border-bottom: 1px solid var(--border-dark);
  margin-bottom: 1.15rem;
  flex-wrap: wrap;
}

.tab-btn {
  background: none;
  border: none;
  color: var(--text-muted);
  font-size: 0.92rem;
  font-weight: 600;
  padding: 0.6rem 1.1rem;
  cursor: pointer;
  border-bottom: 2px solid transparent;
  margin-bottom: -1px;
}

.tab-btn.active {
  color: var(--gold);
  border-bottom-color: var(--gold);
}

.tab-panel {
  display: none;
  color: #cbd5d0;
  font-size: 0.92rem;
}

.tab-panel.active {
  display: block;
}

.checklist {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 0.55rem;
  margin-top: 0.75rem;
}

.checklist li::before {
  content: "✓";
  color: var(--gold);
  font-weight: 900;
  margin-right: 0.6rem;
}

/* 9. Service Strip */
.service-strip {
  background-color: #151a18;
  border-top: 1px solid #242c29;
  border-bottom: 1px solid #242c29;
  padding: 2.25rem 0;
}

.service-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.25rem;
}

.service-card {
  background-color: var(--bg-card);
  border: 1px solid var(--border-dark);
  border-radius: var(--radius);
  padding: 1.15rem;
  display: flex;
  gap: 0.95rem;
  align-items: flex-start;
}

.service-icon {
  width: 42px;
  height: 42px;
  border-radius: 8px;
  background-color: var(--felt-primary);
  border: 1px solid var(--felt-border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.2rem;
  flex-shrink: 0;
}

.service-card h3 {
  font-size: 0.96rem;
  color: #ffffff;
  margin-bottom: 0.2rem;
}

.service-card p {
  font-size: 0.82rem;
  color: var(--text-muted);
}

/* 10. Footer */
.site-footer {
  background-color: var(--bg-dark);
  padding: 2.5rem 0 1.4rem;
  color: #7d8a84;
  font-size: 0.88rem;
}

.footer-grid {
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 2rem;
  padding-bottom: 1.5rem;
  border-bottom: 1px solid #1e2422;
}

.footer-brand {
  font-size: 1.25rem;
  font-weight: 800;
  color: #ffffff;
  margin-bottom: 0.45rem;
}

.footer-brand span {
  color: var(--gold);
}

.footer-bottom {
  text-align: center;
  padding-top: 1.2rem;
  font-size: 0.8rem;
}

/* 11. Cart Drawer & Invoice Modal */
.cart-overlay,
.modal-overlay {
  position: fixed;
  inset: 0;
  background-color: rgba(0, 0, 0, 0.72);
  display: none;
  z-index: 250;
}

.cart-overlay.active {
  display: flex;
  justify-content: flex-end;
}

.modal-overlay.active {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 1.25rem;
}

.cart-drawer {
  background-color: var(--bg-card);
  width: 100%;
  max-width: 430px;
  height: 100%;
  display: flex;
  flex-direction: column;
  border-left: 2px solid var(--gold);
}

.cart-header {
  background-color: var(--felt-primary);
  padding: 1.1rem 1.25rem;
  border-bottom: 1px solid var(--border-dark);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.close-btn {
  background: rgba(17, 20, 19, 0.85);
  color: #ffffff;
  border: 1px solid #3a4440;
  width: 32px;
  height: 32px;
  border-radius: 50%;
  font-size: 1.1rem;
  cursor: pointer;
}

.cart-items {
  flex: 1;
  overflow-y: auto;
  padding: 1rem 1.25rem;
  display: flex;
  flex-direction: column;
  gap: 0.85rem;
}

.cart-item {
  display: flex;
  gap: 0.8rem;
  background-color: var(--bg-input);
  border: 1px solid var(--border-dark);
  padding: 0.75rem;
  border-radius: 8px;
  align-items: center;
}

.cart-item img {
  width: 60px;
  height: 60px;
  object-fit: cover;
  border-radius: 6px;
}

.cart-item-info {
  flex: 1;
}

.cart-item-title {
  font-size: 0.9rem;
  font-weight: 700;
  color: #ffffff;
}

.cart-item-variant {
  font-size: 0.74rem;
  color: var(--text-muted);
}

.cart-item-price {
  font-size: 0.82rem;
  color: var(--gold);
  font-weight: 600;
}

.qty-controls {
  display: flex;
  align-items: center;
  gap: 0.45rem;
  margin-top: 0.35rem;
}

.qty-btn {
  background-color: #262e2b;
  color: #ffffff;
  border: none;
  width: 24px;
  height: 24px;
  border-radius: 4px;
  cursor: pointer;
  font-weight: 700;
}

.remove-btn {
  background: none;
  border: none;
  color: var(--danger);
  font-size: 0.78rem;
  cursor: pointer;
  margin-left: auto;
}

.cart-footer {
  padding: 1.1rem 1.25rem;
  border-top: 1px solid var(--border-dark);
  background-color: #141817;
}

.promo-box {
  display: flex;
  gap: 0.5rem;
  margin-bottom: 0.7rem;
}

.promo-box input {
  flex: 1;
  padding: 0.48rem 0.7rem;
  border-radius: 6px;
  border: 1px solid #2e3834;
  background-color: var(--bg-main);
  color: #ffffff;
  font-size: 0.82rem;
}

.promo-box button {
  background-color: var(--felt-mid);
  color: var(--gold);
  border: 1px solid var(--felt-border);
  padding: 0.48rem 0.85rem;
  border-radius: 6px;
  font-size: 0.8rem;
  font-weight: 700;
  cursor: pointer;
}

.summary-row {
  display: flex;
  justify-content: space-between;
  font-size: 0.84rem;
  color: var(--text-muted);
  margin-bottom: 0.2rem;
}

.discount-line {
  color: var(--mint);
}

.summary-total {
  display: flex;
  justify-content: space-between;
  font-size: 1.08rem;
  font-weight: 700;
  color: var(--gold);
  margin: 0.5rem 0 0.8rem;
  padding-top: 0.5rem;
  border-top: 1px solid var(--border-dark);
}

.checkout-inputs {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  margin-bottom: 0.75rem;
}

.checkout-inputs input,
.checkout-inputs select {
  padding: 0.52rem 0.75rem;
  border-radius: 6px;
  border: 1px solid #2e3834;
  background-color: var(--bg-main);
  color: #ffffff;
  font-size: 0.85rem;
}

.checkout-btns {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.6rem;
}

.btn-sim-order {
  padding: 0.75rem;
  background-color: var(--gold);
  color: var(--bg-main);
  border: none;
  border-radius: 6px;
  font-weight: 700;
  cursor: pointer;
}

.btn-wa-order {
  padding: 0.75rem;
  background-color: #25d366;
  color: #0b141a;
  border: none;
  border-radius: 6px;
  font-weight: 700;
  cursor: pointer;
}

/* Modal Invoice */
.invoice-box {
  background-color: var(--bg-card);
  border: 1px solid var(--gold);
  border-radius: 12px;
  max-width: 500px;
  width: 100%;
  padding: 1.65rem;
  position: relative;
}

.modal-close-pos {
  position: absolute;
  top: 12px;
  right: 12px;
}

.invoice-head {
  text-align: center;
  padding-bottom: 0.9rem;
  border-bottom: 1px dashed #2e3834;
  margin-bottom: 0.9rem;
}

.invoice-badge {
  display: inline-block;
  background-color: var(--felt-mid);
  color: var(--mint);
  border: 1px solid var(--felt-border);
  font-size: 0.75rem;
  font-weight: 700;
  padding: 0.25rem 0.75rem;
  border-radius: 999px;
  margin-bottom: 0.45rem;
}

.invoice-items {
  max-height: 170px;
  overflow-y: auto;
  font-size: 0.85rem;
  margin-bottom: 0.9rem;
}

.inv-row {
  display: flex;
  justify-content: space-between;
  padding: 0.35rem 0;
  border-bottom: 1px solid #222926;
}

.invoice-meta {
  font-size: 0.84rem;
  color: var(--text-muted);
  margin-bottom: 0.8rem;
}

.btn-gold-full {
  width: 100%;
  padding: 0.78rem;
  background-color: var(--gold);
  color: var(--bg-main);
  border: none;
  border-radius: 6px;
  font-weight: 700;
  cursor: pointer;
}

/* Toast */
.toast {
  position: fixed;
  bottom: 24px;
  left: 50%;
  transform: translateX(-50%);
  background-color: var(--felt-primary);
  color: #ffffff;
  border: 1px solid var(--gold);
  padding: 0.7rem 1.25rem;
  border-radius: 8px;
  font-size: 0.9rem;
  font-weight: 600;
  z-index: 300;
  display: none;
}

.toast.show {
  display: block;
}

/* Responsive */
@media (max-width: 900px) {
  .hero-grid,
  .detail-grid,
  .service-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 600px) {
  .top-bar-right {
    display: none;
  }
  .checkout-btns {
    grid-template-columns: 1fr;
  }
}
